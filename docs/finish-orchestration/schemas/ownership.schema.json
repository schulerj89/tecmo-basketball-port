{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ownership.schema.json",
  "title": "Tecmo finish ownership",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "claims", "shared_boundaries", "merge_orders", "policy"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "shared_boundaries": { "type": "array", "items": { "$ref": "#/$defs/boundary" } },
    "merge_orders": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["round_id", "ordered_task_ids", "declared_at"],
        "properties": {
          "round_id": { "type": "string", "minLength": 1 },
          "ordered_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "declared_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_required_before_session_creation", "concurrent_overlap_forbidden", "shared_files_require_sequential_or_designated_owner", "conflicts_returned_for_rescope"],
      "properties": {
        "claim_required_before_session_creation": { "const": true },
        "concurrent_overlap_forbidden": { "const": true },
        "shared_files_require_sequential_or_designated_owner": { "const": true },
        "conflicts_returned_for_rescope": { "const": true }
      }
    }
  },
  "$defs": {
    "nullableDate": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "nullableString": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "task_id", "round_id", "session_id", "mode", "writable_globs", "planned_paths", "concurrency_group", "active", "claimed_at", "released_at", "notes"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "round_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["exclusive", "shared_sequential", "designated_boundary"] },
        "writable_globs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "planned_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "concurrency_group": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "claimed_at": { "type": "string", "format": "date-time" },
        "released_at": { "$ref": "#/$defs/nullableDate" },
        "notes": { "type": "string" }
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary_id", "round_id", "writable_glob", "policy", "designated_task_id", "ordered_task_ids", "notes"],
      "properties": {
        "boundary_id": { "type": "string", "minLength": 1 },
        "round_id": { "type": "string", "minLength": 1 },
        "writable_glob": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "enum": ["sequential", "designated_task"] },
        "designated_task_id": { "$ref": "#/$defs/nullableString" },
        "ordered_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
