{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "queue.schema.json",
  "title": "Tecmo finish task queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "repository", "program_base_sha", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "repository": { "type": "string", "minLength": 1 },
    "program_base_sha": { "$ref": "#/$defs/sha" },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nullableSha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "nullableDate": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "domain", "round_id", "priority", "coordination_only", "state", "dependencies", "ownership_claim_ids", "base_sha", "expected_parent_sha", "branch", "worktree", "sol_orchestrator_session_id", "reported_luna_worker_session_ids", "result_commits", "evidence_ids", "blocker_ids", "replacement_task_id", "task_docs_path", "qa", "merge", "created_at", "updated_at", "audit"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "round_id": { "type": "string", "pattern": "^R[0-9]+[A-Z]?$" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "coordination_only": { "type": "boolean" },
        "state": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "ownership_claim_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "base_sha": { "$ref": "#/$defs/sha" },
        "expected_parent_sha": { "$ref": "#/$defs/sha" },
        "branch": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "sol_orchestrator_session_id": { "type": "string", "minLength": 1 },
        "reported_luna_worker_session_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "result_commits": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha" } },
        "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "blocker_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "replacement_task_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "task_docs_path": { "type": "string", "minLength": 1 },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sol_signoff", "integration_signoff", "test_records", "proof_manifests", "notes"],
          "properties": {
            "status": { "type": "string", "minLength": 1 },
            "sol_signoff": { "type": "boolean" },
            "integration_signoff": { "type": "boolean" },
            "test_records": { "type": "array", "items": { "type": "string" } },
            "proof_manifests": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" }
          }
        },
        "merge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["staging_branch", "merge_order", "status", "merge_commit", "main_pre_sha", "main_post_sha", "push_sha", "pushed_at"],
          "properties": {
            "staging_branch": { "type": "string", "minLength": 1 },
            "merge_order": { "type": "integer", "minimum": 1 },
            "status": { "type": "string", "enum": ["not_ready", "ready", "staged", "merged", "pushed", "conflict", "rejected"] },
            "merge_commit": { "$ref": "#/$defs/nullableSha" },
            "main_pre_sha": { "$ref": "#/$defs/sha" },
            "main_post_sha": { "$ref": "#/$defs/nullableSha" },
            "push_sha": { "$ref": "#/$defs/nullableSha" },
            "pushed_at": { "$ref": "#/$defs/nullableDate" }
          }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "audit": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timestamp", "actor_session_id", "from_state", "to_state", "reason"],
            "properties": {
              "timestamp": { "type": "string", "format": "date-time" },
              "actor_session_id": { "type": "string", "minLength": 1 },
              "from_state": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
              "to_state": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
