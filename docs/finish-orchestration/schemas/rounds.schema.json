{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rounds.schema.json",
  "title": "Tecmo finish rounds",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "rounds"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "rounds": { "type": "array", "items": { "$ref": "#/$defs/round" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nullableSha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "nullableDate": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_id", "title", "status", "base_sha", "scope", "included_task_ids", "staging_branch", "sol_orchestrator_session_ids", "integration_qa_session_id", "merge_order", "combined_qa", "acceptance", "main_integration", "created_at", "updated_at"],
      "properties": {
        "round_id": { "type": "string", "pattern": "^R[0-9]+[A-Z]?$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["planned", "in_progress", "staging", "combined_qa", "ready_for_main", "merged", "pushed", "blocked", "failed"] },
        "base_sha": { "$ref": "#/$defs/sha" },
        "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "included_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "staging_branch": { "type": "string", "minLength": 1 },
        "sol_orchestrator_session_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "integration_qa_session_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "merge_order": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "combined_qa": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "status", "accepted_sha", "report_path", "signed_by_session_id", "notes"],
          "properties": {
            "required": { "type": "boolean" },
            "status": { "type": "string", "enum": ["pending", "in_progress", "accepted", "rejected", "coordination_only"] },
            "accepted_sha": { "$ref": "#/$defs/nullableSha" },
            "report_path": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "signed_by_session_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "notes": { "type": "string" }
          }
        },
        "acceptance": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "accepted_at", "accepted_sha", "criteria"],
          "properties": {
            "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
            "accepted_at": { "$ref": "#/$defs/nullableDate" },
            "accepted_sha": { "$ref": "#/$defs/nullableSha" },
            "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "main_integration": {
          "type": "object", "additionalProperties": false,
          "required": ["pre_main_sha", "merge_commits", "post_main_sha", "remote_main_before_sha", "push_sha", "push_result", "pushed_at"],
          "properties": {
            "pre_main_sha": { "$ref": "#/$defs/sha" },
            "merge_commits": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha" } },
            "post_main_sha": { "$ref": "#/$defs/nullableSha" },
            "remote_main_before_sha": { "$ref": "#/$defs/sha" },
            "push_sha": { "$ref": "#/$defs/nullableSha" },
            "push_result": { "type": "string", "enum": ["not_attempted", "succeeded", "failed", "remote_advanced"] },
            "pushed_at": { "$ref": "#/$defs/nullableDate" }
          }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
